{
  "name": "goal-lite-opencode",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/plugin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
